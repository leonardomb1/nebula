# Copy to .env and fill in. Compose passes this file to the nebula container.

# Public origin of the app (used for OIDC redirect URIs and CSRF checks).
ORIGIN=http://localhost:3000

# --- StarRocks (MySQL protocol, FE query port) ---
# With `docker compose --profile dev up starrocks`, use host `starrocks` from
# inside the compose network, or 127.0.0.1 when running `npm run dev` on the host.
STARROCKS_HOST=starrocks
STARROCKS_PORT=9030

# --- OIDC (used from Milestone 1 on; authentik is the reference IdP) ---
# Issuer is authentik's per-application URL; discovery, JWKS, and endpoints are
# derived from it. The provider must sign with an RSA key (RS256) — StarRocks
# verifies the token against the issuer's JWKS.
#OIDC_ISSUER=https://authentik.example.com/application/o/nebula/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# offline_access is required — without a refresh token, StarRocks access dies
# when the short-lived id_token expires (~5 min on authentik defaults).
#OIDC_SCOPES=openid profile email offline_access

# Secret for encrypting the app session and the server-side token store (M1+).
# Generate with: openssl rand -base64 32
#SESSION_SECRET=

# Result grid row cap per statement (server kills the query past it).
#MAX_RESULT_ROWS=10000

# DEV ONLY — run every query as this native StarRocks account instead of the
# signed-in user's JWT. Lets the IDE work against the compose StarRocks with
# no IdP wired (e.g. root with empty password). NEVER set in production.
#DEV_STARROCKS_USER=root
#DEV_STARROCKS_PASSWORD=
